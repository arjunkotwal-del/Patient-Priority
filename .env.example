# Browser (exposed to the client bundle; not secret)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.patient-priority.app

# Server only (secret)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.patient-priority.app
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_CARD_ENC_KEY=
HEALTH_CARD_HASH_KEY=

# Gemini powers the patient interview (server only, secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Postgres (TigerData) for patient history (server only, secret)
DATABASE_URL=

# Doctor logins are email + password, created only by npm run doctor:add (no sign-up).
# Signs doctor sessions. Optional: falls back to a key derived from HEALTH_CARD_HASH_KEY.
DOCTOR_SESSION_SECRET=
# The demo doctor login that npm run db:setup / npm run doctor:demo create.
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=DemoDoctor123!

# Optional demo patient login: your Auth0 user id (Auth0 dashboard > User Management > Users).
# npm run db:setup links it to a demo patient.
DEMO_PATIENT_AUTH0_ID=
DEMO_PATIENT_ID=demo-maya

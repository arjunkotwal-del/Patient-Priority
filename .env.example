# Browser (exposed to the client bundle; not secret)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.patient-priority.app

# Server only (secret)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.patient-priority.app
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HEALTH_CARD_ENC_KEY=
HEALTH_CARD_HASH_KEY=

# Gemini powers the patient interview (server only, secret)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

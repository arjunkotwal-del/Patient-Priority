{
  "name": "patient-priority",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"node --watch server.js --dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test --test-timeout=10000 server/*.test.js lib/*.test.js src/lib/*.test.js",
    "db:setup": "node server/dbSetup.js",
    "doctor:add": "node server/addDoctor.js",
    "doctor:remove": "node server/addDoctor.js --remove",
    "doctor:demo": "node server/demoDoctor.js"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "express": "^5.3.0",
    "jose": "^6.2.15",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
